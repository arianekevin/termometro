# Where Termometro is reached. Your DNS must point this name at the server.
TERMOMETRO_DOMAIN=termometro.example.com

# Your projects. Make a key with: docker compose run --rm termometro python termometro.py new-key
# origins: where the collector may send from (your app's address); url: your app, for the heat map.
TERMOMETRO_PROJECTS=[{"name":"my-app","key":"tk_REPLACE","origins":["https://app.example.com"],"url":"https://app.example.com"}]

# A way in — a password, Google, or both.
TERMOMETRO_PASSWORD=
# TERMOMETRO_GOOGLE_CLIENT_ID=
# TERMOMETRO_GOOGLE_CLIENT_SECRET=
# TERMOMETRO_ALLOWED_DOMAINS=example.com
# TERMOMETRO_ALLOWED_EMAILS=

# How long events with user ids are kept, in days.
# TERMOMETRO_RETENTION_DAYS=90
